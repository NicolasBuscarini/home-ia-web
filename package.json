{
  "name": "garage-watch-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "biome lint .",
    "format:check": "biome ci .",
    "format": "biome format . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ct02": "playwright test --config=playwright.ct02.config.ts",
    "verify": "npm run lint && npm run format:check && npm run test:run && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "bootstrap": "5.3.8",
    "hls.js": "1.7.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@playwright/test": "1.56.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
